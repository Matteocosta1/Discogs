# Copia questo file in .env e inserisci i tuoi valori.
# Il file .env non viene mai salvato nella repository.

# Token personale di Discogs (https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=

# Solo se usi l'opzione --ai: chiave API di Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
