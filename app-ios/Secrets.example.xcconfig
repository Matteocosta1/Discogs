// Copia questo file in Secrets.xcconfig (che NON va su GitHub: è in .gitignore) e riempi i valori.
// Non serve toccare Xcode: Config/Base.xcconfig lo legge da solo, se esiste.
// Nota: in un .xcconfig "//" inizia un commento, quindi negli URL si scrive https:/$()/...

DISCOGS_CONSUMER_KEY = la_consumer_key_della_tua_app_discogs
DISCOGS_CONSUMER_SECRET = il_consumer_secret_della_tua_app_discogs
SUPABASE_URL = https:/$()/xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY = la_chiave_anon_public_di_supabase
